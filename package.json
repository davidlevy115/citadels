{
  "name": "citadels",
  "private": true,
  "scripts": {
    "play": "pnpm --filter @citadels/game-logic build && pnpm --parallel --filter @citadels/server --filter @citadels/web dev",
    "dev": "pnpm --parallel --filter @citadels/server --filter @citadels/web dev",
    "build": "pnpm --filter @citadels/game-logic build && pnpm --parallel --filter @citadels/server --filter @citadels/web build",
    "test": "pnpm --filter @citadels/game-logic test",
    "check:i18n": "pnpm --filter @citadels/game-logic build && node_modules/.pnpm/esbuild@0.28.0/node_modules/esbuild/bin/esbuild scripts/check-i18n.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/check-i18n.cjs --alias:@citadels/game-logic=./packages/game-logic/dist/index.js --log-level=error && node node_modules/.cache/check-i18n.cjs"
  },
  "engines": {
    "node": ">=20"
  }
}
